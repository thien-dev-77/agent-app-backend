# Database - Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (for video generation)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server
PORT=3001

# Auth
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password
AUTH_TOKEN_SECRET=change-this-long-random-secret

# Facebook Messenger / Fanpage
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_GRAPH_VERSION=v22.0
BACKEND_PUBLIC_URL=https://api.your-domain.com
FRONTEND_URL=https://your-frontend-domain.com/chatbot-training
# Optional if callback URL differs from BACKEND_PUBLIC_URL:
# FACEBOOK_OAUTH_REDIRECT_URI=https://api.your-domain.com/api/chatbot-training/facebook/oauth/callback
